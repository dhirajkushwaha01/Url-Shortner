<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Home Page</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0e1424;
            --bg-glow: #1a2544;
            --panel: #151d33;
            --panel-2: #1b2540;
            --line: rgba(255, 255, 255, 0.08);
            --text: #e9ecf5;
            --muted: #8d97b3;
            --gold: #d4b46a;
            --gold-deep: #b8954a;
            --ink: #1a1405;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Manrope", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            background:
                radial-gradient(900px 500px at 15% -10%, var(--bg-glow), transparent 70%),
                radial-gradient(700px 400px at 100% 0%, rgba(212, 180, 106, 0.08), transparent 70%),
                var(--bg);
            background-attachment: fixed;
            padding: 56px 20px 72px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 920px;
            margin: 0 auto;
        }

        h1 {
            font-family: "Fraunces", Georgia, serif;
            font-weight: 600;
            font-size: clamp(2.2rem, 5vw, 3.2rem);
            letter-spacing: -0.02em;
            margin: 0 0 8px;
            color: #fff;
        }

        .subtitle {
            margin: 0;
            color: var(--muted);
            font-size: 1rem;
        }

        /* Top bar with Login / Signup */
        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 36px;
        }

        .nav {
            display: flex;
            gap: 10px;
            padding-top: 6px;
        }

        .btn {
            display: inline-block;
            padding: 11px 22px;
            font-weight: 700;
            font-size: 0.92rem;
            text-decoration: none;
            border-radius: 12px;
            white-space: nowrap;
            transition: transform 0.15s, box-shadow 0.15s, filter 0.15s, border-color 0.2s, background 0.2s;
        }

        .btn:focus-visible {
            outline: 3px solid rgba(212, 180, 106, 0.5);
            outline-offset: 3px;
        }

        .btn-ghost {
            color: var(--text);
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, 0.04);
        }

        .btn-ghost:hover {
            border-color: var(--gold);
            background: rgba(212, 180, 106, 0.08);
        }

        .btn-solid {
            color: var(--ink);
            background: linear-gradient(135deg, #e6cb8a, var(--gold-deep));
            box-shadow: 0 10px 24px -10px rgba(212, 180, 106, 0.7);
        }

        .btn-solid:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
        }

        .btn-logout {
            color: #f0a5a5;
            border: 1px solid rgba(240, 165, 165, 0.3);
            background: rgba(240, 100, 100, 0.06);
        }

        .btn-logout:hover {
            color: #fff;
            border-color: rgba(240, 120, 120, 0.7);
            background: rgba(240, 100, 100, 0.18);
        }

        /* Generated URL notice */
        .result {
            margin: 0 0 24px;
            padding: 16px 20px;
            border-radius: 14px;
            background: rgba(212, 180, 106, 0.08);
            border: 1px solid rgba(212, 180, 106, 0.35);
            color: var(--muted);
            font-size: 0.92rem;
            word-break: break-all;
            animation: reveal 0.45s ease both;
        }

        .result strong {
            display: block;
            margin-bottom: 4px;
            color: var(--gold);
            font-weight: 600;
        }

        .result span {
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
        }

        @keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Form card */
        .card {
            background: linear-gradient(180deg, var(--panel-2), var(--panel));
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.6);
            margin-bottom: 28px;
        }

        label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text);
        }

        .field {
            display: flex;
            gap: 12px;
        }

        input[type="text"] {
            flex: 1;
            min-width: 0;
            padding: 15px 18px;
            font: inherit;
            color: var(--text);
            background: rgba(8, 12, 24, 0.55);
            border: 1px solid var(--line);
            border-radius: 12px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input[type="text"]::placeholder {
            color: #5d6784;
        }

        input[type="text"]:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 4px rgba(212, 180, 106, 0.16);
        }

        button[type="submit"] {
            padding: 15px 28px;
            font: inherit;
            font-weight: 700;
            color: var(--ink);
            background: linear-gradient(135deg, #e6cb8a, var(--gold-deep));
            border: 0;
            border-radius: 12px;
            cursor: pointer;
            white-space: nowrap;
            box-shadow: 0 10px 24px -10px rgba(212, 180, 106, 0.7);
            transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
        }

        button[type="submit"]:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
            box-shadow: 0 14px 28px -10px rgba(212, 180, 106, 0.8);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }

        button[type="submit"]:focus-visible {
            outline: 3px solid rgba(212, 180, 106, 0.5);
            outline-offset: 3px;
        }

        /* Table */
        .table-wrap {
            overflow-x: auto;
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.6);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.93rem;
        }

        thead th {
            text-align: left;
            padding: 16px 20px;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--muted);
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        tbody td {
            padding: 16px 20px;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr {
            transition: background 0.2s;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.035);
        }

        tbody td:first-child {
            color: var(--muted);
            width: 72px;
        }

        tbody td:nth-child(2) {
            font-family: Consolas, "SFMono-Regular", Menlo, monospace;
            color: var(--gold);
            font-weight: 600;
        }

        tbody td:nth-child(3) {
            max-width: 340px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #c4cbe0;
        }

        tbody td:last-child {
            font-weight: 700;
            color: #fff;
        }

        @media (max-width: 600px) {
            body {
                padding: 36px 14px 56px;
            }

            .card {
                padding: 20px;
            }

            .topbar {
                flex-direction: column;
            }

            .nav {
                width: 100%;
                padding-top: 0;
            }

            .nav .btn {
                flex: 1;
                text-align: center;
            }

            .field {
                flex-direction: column;
            }

            button[type="submit"] {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>

</head>

<body>

    <div class="container">

        <header class="topbar">
            <div>
                <h1>URL Shortener</h1>
                <p class="subtitle">Paste a long link and get a short one you can share.</p>
            </div>
            <nav class="nav">
                
                <a class="btn btn-ghost" href="/login">Login</a>
                <a class="btn btn-solid" href="/signup">Signup</a>
                <a class="btn btn-logout" href="/user/logout">Logout</a>
            </nav>
        </header>

        <% if (locals.id) { %>
            <p class="result">
                <strong>URL Generated</strong>
                <span>http://localhost:8001/url/<%= id %></span>
            </p>

            <%} %>
                <div class="card">
                    <form method="POST" action="/url">
                        <label for="url">Enter Your Original URL</label>
                        <div class="field">
                            <input type="text" id="url" name="url" placeholder="https://example.com">
                            <button type="submit">Generate</button>
                        </div>
                    </form>
                </div>
                <div>
                    <% if (locals.urls) { %>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>S. No</th>
                                        <th>ShortID</th>
                                        <th>Redirect</th>
                                        <th>Clicks</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <% urls.forEach((url, index)=> { %>

                                        <tr>
                                            <td>
                                                <%= index + 1 %>
                                            </td>
                                            <td>
                                                <%= url.shortId %>
                                            </td>
                                            <td>
                                                <%= url.redirectURL %>
                                            </td>
                                            <td>
                                                <%= url.visitHistory.length %>
                                            </td>
                                        </tr>

                                        <% }) %>

                                </tbody>
                            </table>
                        </div>

                        <% } %>
                </div>

    </div>
</body>

</html>
