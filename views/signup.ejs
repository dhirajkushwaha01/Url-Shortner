<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --bg: #0e1424;
            --bg-glow: #1a2544;
            --panel: #151d33;
            --panel-2: #1b2540;
            --line: rgba(255, 255, 255, 0.08);
            --text: #e9ecf5;
            --muted: #8d97b3;
            --gold: #d4b46a;
            --gold-deep: #b8954a;
            --ink: #1a1405;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Manrope", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            background:
                radial-gradient(900px 500px at 15% -10%, var(--bg-glow), transparent 70%),
                radial-gradient(700px 400px at 100% 0%, rgba(212, 180, 106, 0.08), transparent 70%),
                var(--bg);
            background-attachment: fixed;
            padding: 32px 20px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .auth {
            width: 100%;
            max-width: 420px;
            background: linear-gradient(180deg, var(--panel-2), var(--panel));
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 40px 32px 36px;
            box-shadow: 0 30px 70px -24px rgba(0, 0, 0, 0.7);
        }

        h1 {
            font-family: "Fraunces", Georgia, serif;
            font-weight: 600;
            font-size: 2.2rem;
            letter-spacing: -0.02em;
            margin: 0 0 6px;
            color: #fff;
        }

        .subtitle {
            margin: 0 0 28px;
            color: var(--muted);
            font-size: 0.95rem;
        }

        form {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--text);
        }

        input {
            width: 100%;
            padding: 14px 16px;
            margin-bottom: 20px;
            font: inherit;
            color: var(--text);
            background: rgba(8, 12, 24, 0.55);
            border: 1px solid var(--line);
            border-radius: 12px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 4px rgba(212, 180, 106, 0.16);
        }

        /* Browser autofill keeps the dark look */
        input:-webkit-autofill {
            -webkit-text-fill-color: var(--text);
            box-shadow: 0 0 0 1000px #0b1120 inset;
            caret-color: var(--text);
        }

        button[type="submit"] {
            margin-top: 6px;
            padding: 15px 28px;
            font: inherit;
            font-weight: 700;
            color: var(--ink);
            background: linear-gradient(135deg, #e6cb8a, var(--gold-deep));
            border: 0;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 10px 24px -10px rgba(212, 180, 106, 0.7);
            transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
        }

        button[type="submit"]:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
            box-shadow: 0 14px 28px -10px rgba(212, 180, 106, 0.8);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }

        button[type="submit"]:focus-visible {
            outline: 3px solid rgba(212, 180, 106, 0.5);
            outline-offset: 3px;
        }

        @media (max-width: 480px) {
            .auth {
                padding: 32px 22px 28px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                transition: none !important;
            }
        }
    </style>

</head>

<body>
    <div class="auth">
        <h1>Signup</h1>
        <p class="subtitle">Create an account to save and track your short links.</p>

        <form action="/user" method="post">

            <label for="name">Full Name</label>
            <input type="text" id="name" required name="name" />

            <label for="email">Email</label>
            <input type="email" id="email" required name="email" />

            <label for="password">Password</label>
            <input type="password" id="password" required name="password" />

            <button type="submit">Signup</button>

        </form>
    </div>
</body>

</html>